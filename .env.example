# ============================================
# Database Configuration
# ============================================
DB_USER=ecommerce
DB_PASSWORD=secure_password_123
DB_NAME=hardware_ecommerce
DB_PORT=5432

# ============================================
# Spring Boot Configuration
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=86400000
JPA_DDL_AUTO=validate

# ============================================
# Server Configuration
# ============================================
BACKEND_PORT=8080
FRONTEND_PORT=80

# ============================================
# API Configuration
# ============================================
API_BASE_URL=http://localhost/api

# ============================================
# CORS Configuration (for production)
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost,https://yourdomain.com

# ============================================
# Email Configuration (Optional - for future)
# ============================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@hardwareecommerce.com

# ============================================
# Payment Gateway (Optional - Stripe Example)
# ============================================
STRIPE_API_KEY=sk_test_your_stripe_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================
# AI/LLM Configuration (Optional)
# ============================================
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4

# ============================================
# Cloud Storage (Optional - AWS S3 Example)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=hardware-ecommerce-images
AWS_S3_REGION=us-east-1

# ============================================
# Monitoring & Logging (Optional)
# ============================================
LOG_LEVEL=INFO
SPRING_PROFILES_ACTIVE=production

# ============================================
# Security (Production)
# ============================================
SPRING_SECURITY_REQUIRE_HTTPS=false
SESSION_TIMEOUT=1800

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node", "@playwright/test"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src", "tests", "playwright.config.ts"]
}
